{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:4000/*" },
        { "url": "http://127.0.0.1:4000/*" }
      ],
      "deny": []
    }
  ]
}
